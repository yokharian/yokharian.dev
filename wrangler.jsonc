{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yokharian-dev",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-27",

  // Static site output. `run_worker_first` is required so the Worker can answer
  // `Accept: text/markdown` requests before the HTML asset is served.
  // `drop-trailing-slash` matches Astro's `trailingSlash: "never"` canonical
  // URLs: Astro emits `about/index.html`, which Workers would otherwise serve
  // at `/about/` and 308-redirect `/about` to it.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Required by `wrangler preview` (Workers Builds deploy command). Empty
  // because Previews need no settings that differ from production.
  "previews": {}
}
